{
  "manifest_version": 3,
  "name": "TrustLens - Site & Email Legitimacy Checker",
  "version": "0.1.0",
  "description": "Click the icon to score the current site's trust. Warns you on risky domains and suspicious emails.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://rdap.org/*",
    "https://cloudflare-dns.com/*",
    "https://dns.google/*",
    "https://crt.sh/*",
    "https://safebrowsing.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://ipinfo.io/*",
    "https://*.workers.dev/*",
    "https://disposable.github.io/*",
    "https://data.phishtank.com/*",
    "https://urlhaus-api.abuse.ch/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Check this site",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content_signals.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
